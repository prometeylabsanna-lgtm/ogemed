# OGEMED — DigitalOcean Droplet (Docker Compose)
# cp .env.docker.example .env  &&  nano .env
# Після SSL: SESSION/CSRF_COOKIE_SECURE=True, SITE_URL=https://..., CSRF з https://

SECRET_KEY=change-me-generate-with-python-secrets
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.docker

# Postgres (compose service: db)
POSTGRES_DB=ogemed
POSTGRES_USER=ogemed
POSTGRES_PASSWORD=change-me-strong-db-password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://ogemed:change-me-strong-db-password@db:5432/ogemed

# Домен + IP Droplet + internal healthcheck names
# Заміни DROPLET_IP на реальний IPv4 (напр. 203.0.113.10) — НЕ лишай слово DROPLET_IP
ALLOWED_HOSTS=oge.in.ua,www.oge.in.ua,DROPLET_IP,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=https://oge.in.ua,https://www.oge.in.ua

SITE_URL=https://oge.in.ua
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Секретний URL адмінки (літери/цифри). /admin/ завжди 404.
ADMIN_URL=ogm8k2x9p4qh7n

FROM_EMAIL=noreply@oge.in.ua
LIQPAY_SANDBOX=False
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=
# LIQPAY_SERVER_URL=https://oge.in.ua/payments/liqpay/callback/

# RESEND_API_KEY=
# NP_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

NOTIFY_USE_QUEUE=False
STATIC_VERSION=1
HTTP_PORT=80
