# Django
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database (production / optional local Postgres)
# DATABASE_URL=postgres://ogemed:password@127.0.0.1:5432/ogemed
# Vercel / Neon: postgres://user:pass@host/db?sslmode=require

# Media on Vercel (S3 / R2 / Spaces) — без bucket файли не персистяться
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=pub-xxxx.r2.dev

# Site
SITE_URL=http://127.0.0.1:8000

# --- Integrations (secrets only in env; empty = feature skipped gracefully) ---

# Resend (email)
# RESEND_API_KEY=re_xxx
FROM_EMAIL=noreply@example.com

# LiqPay (online pay). Without keys checkout still works with COD.
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=
# LIQPAY_SERVER_URL=https://example.com/payments/liqpay/callback/
LIQPAY_SANDBOX=True

# Nova Poshta (city / warehouse lookup). Empty key → empty autocomplete lists.
# NP_API_KEY=
# NP_SENDER_REF=
# NP_SENDER_CONTACT_REF=
# NP_SENDER_CITY_REF=
# NP_SENDER_ADDRESS_REF=
# NP_SENDER_PHONE=

# Telegram admin notify (both required)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# Viber admin notify (both required)
# VIBER_AUTH_TOKEN=
# VIBER_ADMIN_ID=

# Async notify queue (Django-Q2). Start worker: python manage.py qcluster
# NOTIFY_USE_QUEUE=True
# REDIS_URL=redis://127.0.0.1:6379/0
# Без REDIS_URL використовується ORM-брокер (таблиці Django-Q).
